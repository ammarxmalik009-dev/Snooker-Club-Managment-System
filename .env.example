# Copy this file to ".env" (same folder) and change the values if needed.
# The real .env file is never committed to Git - it may contain passwords later.
#
# Every variable below has a safe default except AUTH_SECRET, which the app REQUIRES in production
# (server/config/env.js refuses to start without one there). Everything else is optional: leave it
# blank and the app falls back to the default shown in its comment.

# Port the web server listens on -> http://localhost:3000
PORT=3000

# MongoDB connection string. "snooker_club_pro" is the database name;
# MongoDB creates it automatically the first time data is saved.
MONGODB_URI=mongodb://127.0.0.1:27017/snooker_club_pro

# The club's timezone: used to decide what "a day" means for date filters and reports.
# Times are always stored in UTC in the database.
CLUB_TIMEZONE=Asia/Karachi

# Optional - only used by "npm run db" (portable MongoDB). Leave empty to use the defaults:
#   %LOCALAPPDATA%\SnookerClubPro\mongodb\bin\mongod.exe  and  %LOCALAPPDATA%\SnookerClubPro\mongo-data
MONGOD_PATH=
MONGO_DATA_DIR=

# ---- Login (Phase 8) ----
# REQUIRED in production (NODE_ENV=production): the app refuses to start without one.
# Secret that protects login sessions. Use a long random value and keep it private.
# Create one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In development, a missing/weak one only prints a warning and uses a temporary secret
# (logins end whenever the server restarts).
AUTH_SECRET=change-me-to-a-long-random-value

# Hours a login stays valid (1-720). After that the user signs in again.
SESSION_TTL_HOURS=12

# true = only send the login cookie over HTTPS (set true when you serve the app with HTTPS)
COOKIE_SECURE=false

# ---- Deployment readiness (Phase 1): only needed when hosting online, e.g. backend on Railway,
#      frontend on Vercel. Leave both empty on the club PC - nothing here changes its behaviour. ----

# How many proxies sit in front of this app, so the login lock sees the visitor's REAL address
# instead of the proxy's (otherwise one person's failed logins could lock out everyone else too).
# Empty/false = no proxy (the club PC). A number 1-5, or a comma list of trusted proxy addresses.
# The right number for Railway/Vercel must be checked after deploying - see docs/POSTGRES_MIGRATION.md.
# "true" (trust every proxy blindly) is refused: it would let a visitor fake their own address.
TRUST_PROXY=

# Extra website(s) allowed to send changes (POST/PATCH/DELETE), on top of this app's own address.
# Needed only when the frontend is hosted elsewhere (e.g. Vercel) and reaches this API through a
# rewrite: the browser's Origin is then that other address, not this server's. Comma list of EXACT
# addresses, e.g. https://your-app.vercel.app - no wildcard, no path. Empty = only this app itself
# (the club PC). See docs/POSTGRES_MIGRATION.md.
ALLOWED_ORIGINS=

# PostgreSQL (Phase 2, OPTIONAL FOUNDATION ONLY - see docs/POSTGRES_MIGRATION.md). The app's real
# database today is still MongoDB (MONGODB_URI above); this is unused unless something explicitly
# calls server/config/db.pg.js. Leave empty - nothing breaks and nothing connects.
# Example only, never a real password: postgres://USER:PASSWORD@localhost:5432/snooker_club_pro
DATABASE_URL=

# ---- Backups (XML) ----
# Folder for the automatic XML backups (Settings page: every N hours, default 12).
# Use a folder OUTSIDE the C: drive (another drive, a USB drive or a OneDrive / Google Drive folder),
# so the backups survive when Windows or the system drive breaks.
# Empty = %LOCALAPPDATA%\SnookerClubPro\backups (on the system drive: the Settings page warns about it)
BACKUP_DIR=D:\SnookerClubPro-Backups

# "development" shows extra details in the server log; use "production" on the real club PC
NODE_ENV=development
