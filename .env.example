# Copy this file to ".env" (same folder) and change the values if needed.
# The real .env file is never committed to Git - it may contain passwords later.

# Port the web server listens on -> http://localhost:3000
PORT=3000

# MongoDB connection string. "snooker_club_pro" is the database name;
# MongoDB creates it automatically the first time data is saved.
MONGODB_URI=mongodb://127.0.0.1:27017/snooker_club_pro

# The club's timezone: used to decide what "a day" means for date filters and reports.
# Times are always stored in UTC in the database.
CLUB_TIMEZONE=Asia/Karachi

# Optional - only used by "npm run db" (portable MongoDB). Leave empty to use the defaults:
#   %LOCALAPPDATA%\SnookerClubPro\mongodb\bin\mongod.exe  and  %LOCALAPPDATA%\SnookerClubPro\mongo-data
MONGOD_PATH=
MONGO_DATA_DIR=

# ---- Login (Phase 8) ----
# Secret that protects login sessions. Use a long random value and keep it private.
# Create one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-value

# Hours a login stays valid (1-720). After that the user signs in again.
SESSION_TTL_HOURS=12

# true = only send the login cookie over HTTPS (set true when you serve the app with HTTPS)
COOKIE_SECURE=false

# ---- Backups (XML) ----
# Folder for the automatic XML backups (Settings page: every N hours, default 12).
# Use a folder OUTSIDE the C: drive (another drive, a USB drive or a OneDrive / Google Drive folder),
# so the backups survive when Windows or the system drive breaks.
# Empty = %LOCALAPPDATA%\SnookerClubPro\backups (on the system drive: the Settings page warns about it)
BACKUP_DIR=D:\SnookerClubPro-Backups

# "development" shows extra details in the server log; use "production" on the real club PC
NODE_ENV=development
